{
  "name": "knowledge-export-redaction",
  "description": "Scan a fixture export deterministically and use pi only to summarize safe remediation.",
  "stages": [
    {
      "id": "scan-export",
      "kind": "command",
      "command": "python",
      "args": ["-m", "pytest", "tests/test_export_redaction.py", "-q"],
      "stdout": "run/redaction-test.txt",
      "attempts": 1,
      "gate": {
        "kind": "contains",
        "path": "run/redaction-test.txt",
        "values": ["passed"]
      }
    },
    {
      "id": "summarize-safe-remediation",
      "kind": "harness",
      "provider": "pi",
      "prompt": "Summarize remediation using only scanner diagnostics. Never reproduce candidate secret values. Include verification.",
      "inputs": [
        {
          "path": "run/redaction-test.txt",
          "maxBytes": 8000
        }
      ],
      "output": "run/redaction-remediation.md",
      "attempts": 2,
      "models": {
        "fast": "github-copilot/gpt-5-mini",
        "strong": "openai-codex/gpt-5.4"
      },
      "gate": {
        "kind": "contains",
        "values": ["Verification:"]
      }
    }
  ]
}
