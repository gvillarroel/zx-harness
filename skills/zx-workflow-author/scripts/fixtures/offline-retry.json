{
  "name": "offline-retry-proof",
  "description": "Prove runtime problem input, reduced context, agent retry, independent review, gates, and rollback.",
  "controls": [
    {
      "path": ".policy/workflow-control.txt",
      "sha256": "sha256:a42c67ec55b8fcec991d265ecd5f0f173465cbe5831f35954175db654b28debc"
    }
  ],
  "agents": {
    "solver": {
      "provider": "fixture-solver",
      "command": "node",
      "args": ["--version"],
      "promptMode": "stdin"
    },
    "reviewer": {
      "provider": "fixture-reviewer",
      "command": "node",
      "args": ["--version"],
      "promptMode": "stdin"
    }
  },
  "stages": [
    {
      "id": "collect-problem",
      "kind": "command",
      "command": "node",
      "args": ["-e", "require('node:fs').writeFileSync('input.txt', process.argv[1])", "{problem}"],
      "stdout": "run/collect.txt"
    },
    {
      "id": "rank",
      "kind": "tfidf",
      "roots": ["input.txt"],
      "extensions": [".txt"],
      "output": "run/ranked.json",
      "gate": {
        "kind": "json",
        "path": "run/ranked.json",
        "required": ["0.path", "0.score"]
      }
    },
    {
      "id": "reason",
      "kind": "agent",
      "agent": "solver",
      "prompt": "Return an approved solution with a verification section.",
      "inputs": [{ "path": "run/ranked.json", "maxBytes": 4000 }],
      "output": "run/proposal.md",
      "attempts": 3,
      "models": {
        "fast": "fast-fixture-model",
        "strong": "strong-fixture-model"
      },
      "gate": {
        "kind": "contains",
        "values": ["APPROVED", "Verification:"]
      },
      "reviewers": [
        {
          "id": "quality-review",
          "agent": "reviewer",
          "model": "review-fixture-model",
          "prompt": "Reject unsupported claims and confirm the proposed verification is sufficient."
        }
      ]
    },
    {
      "id": "prepare-mutation",
      "kind": "command",
      "command": "node",
      "args": ["-e", "require('node:fs').writeFileSync('protected.txt', 'original')"]
    },
    {
      "id": "redact-diagnostics",
      "kind": "command",
      "command": "node",
      "args": ["-e", "if(process.env.ZX_WORKFLOW_ATTEMPT==='1'){process.stderr.write('token=fixture-secret');process.exit(1)}"],
      "attempts": 2
    },
    {
      "id": "retry-mutation",
      "kind": "command",
      "command": "node",
      "args": ["-e", "const fs=require('node:fs'); const attempt=process.env.ZX_WORKFLOW_ATTEMPT; const clean=fs.readFileSync('protected.txt','utf8')==='original'; fs.writeFileSync('protected.txt', attempt==='2'&&clean?'accepted':'changed')"],
      "mutates": ["protected.txt"],
      "attempts": 2,
      "gate": {
        "kind": "contains",
        "path": "protected.txt",
        "values": ["accepted"]
      }
    }
  ]
}
