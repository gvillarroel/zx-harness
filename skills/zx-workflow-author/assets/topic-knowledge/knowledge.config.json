{
  "topic": "agentic retrieval augmented generation",
  "sources": [
    {
      "type": "arxiv-search",
      "query": "{topic}",
      "maxResults": 5,
      "sortBy": "relevance",
      "sortOrder": "descending"
    },
    {
      "type": "site",
      "url": "https://example.com/topic-notes",
      "sourceId": "topic-notes",
      "maxDepth": 1,
      "maxPages": 10,
      "enabled": false
    },
    {
      "type": "github-repo",
      "url": "https://github.com/example/topic-repository",
      "branches": [
        "main"
      ],
      "enabled": false
    }
  ],
  "processor": {
    "required": false,
    "autoDiscover": false,
    "timeoutMs": 900000,
    "probeTimeoutMs": 5000,
    "harnesses": []
  },
  "export": true
}
