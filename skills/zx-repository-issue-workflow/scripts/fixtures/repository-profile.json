{
  "schemaVersion": 1,
  "name": "fixture-issue-workflow",
  "description": "Solve bounded maintenance and concurrency issues in the fixture repository.",
  "repository": {
    "summary": "Small Node ESM library with product modules in src and one executable test entrypoint.",
    "architecture": [
      "src/range.mjs owns integer range construction",
      "src/queue.mjs owns asynchronous queue behavior",
      "test.mjs is the repository acceptance command"
    ],
    "conventions": [
      "Keep exports backward compatible",
      "Prefer the smallest implementation that passes focused tests"
    ],
    "roots": ["src", "test.mjs", "package.json", "AGENTS.md"],
    "extensions": [".js", ".mjs", ".json", ".md"],
    "alwaysInclude": ["package.json", "AGENTS.md"],
    "ignore": ["node_modules", "coverage", ".env"],
    "protectedPaths": ["protected.txt"],
    "maxScanFiles": 40,
    "contextFiles": 4,
    "maxFileBytes": 2048,
    "maxContextBytes": 8192
  },
  "models": {
    "luna": "openai-codex/gpt-5.6-luna",
    "sol": "openai-codex/gpt-5.6-sol",
    "lunaThinking": "medium",
    "solThinking": "max"
  },
  "attempts": 2,
  "defaultSector": "maintenance",
  "defaultSkills": ["issue-testing"],
  "sectors": [
    {
      "id": "maintenance",
      "description": "Localized range, validation, test, and documentation defects.",
      "terms": ["range", "inclusive", "validation", "test", "documentation"],
      "roots": ["src", "test.mjs"],
      "model": "luna",
      "skills": ["issue-testing"]
    },
    {
      "id": "concurrency",
      "description": "Queue races, concurrency, locks, transactions, and cross-cutting state changes.",
      "terms": ["queue", "race", "concurrency", "lock", "transaction"],
      "roots": ["src"],
      "model": "sol",
      "skills": ["concurrency-review"]
    }
  ],
  "gates": [
    {
      "id": "tests",
      "command": "node",
      "args": ["test.mjs"],
      "timeoutMs": 30000
    }
  ],
  "pi": {"timeoutMs": 600000}
}
